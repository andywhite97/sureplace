{
  "name": "sure-place",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:mobile": "ng run SurePlace:build-mobile",
    "preview:mobile": "ng serve --build-target SurePlace:build-mobile:preview --port 4300 --proxy-config proxy.mobile.json",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node scripts/build-android.mjs",
    "build:ghpages": "node scripts/build-ghpages.mjs --mode custom",
    "build:ghpages:repo": "node scripts/build-ghpages.mjs --mode repo",
    "deploy:ghpages": "node scripts/deploy-ghpages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.0",
    "@capacitor/share": "8.0.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "swiper": "^12.0.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@capacitor/cli": "8.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.17.19",
    "gh-pages": "6.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
